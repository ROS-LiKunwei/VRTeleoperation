<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sysbot">

  <!-- Import SysBot macro -->
  <xacro:include filename="$(find sysmo_description)/urdf/sysbot_links.urdf.xacro" />
  <xacro:include filename="$(find sysmo_description)/urdf/sysbot_joints.urdf.xacro" />

  <xacro:links/>
  <xacro:joints/>

  <!-- Dummy root link to address KDL limitation -->
  <link name="dummy_root"/>

  <joint name="fixed_joint_dummy_root_to_base" type="fixed">
    <parent link="dummy_root"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>